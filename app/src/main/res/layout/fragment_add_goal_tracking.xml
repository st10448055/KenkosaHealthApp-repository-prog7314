<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_bg"
    android:clipChildren="false">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollAddGoal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNav"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="120dp">

            <!-- Header: menu + notification bell -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageButton
                    android:id="@+id/buttonMenu"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_centerVertical="true"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/menu"
                    android:src="@drawable/ic_menu"
                    app:tint="@color/settings_title" />

                <FrameLayout
                    android:id="@+id/buttonNotifications"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/bg_circle_deep_green"
                    android:contentDescription="@string/notifications">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_bell"
                        app:tint="@color/white" />
                </FrameLayout>
            </RelativeLayout>

            <TextView
                android:id="@+id/textTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="8dp"
                android:text="@string/goaltrack_add_title"
                android:textColor="@color/settings_title"
                android:textSize="30sp"
                android:textStyle="bold" />

            <!-- Category -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="24dp"
                android:text="@string/goaltrack_category_label"
                android:textColor="@color/settings_title"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSteps"
                    style="@style/Widget.Goaltrack.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/goaltrack_cat_steps" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipWater"
                    style="@style/Widget.Goaltrack.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/goaltrack_cat_water" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSleep"
                    style="@style/Widget.Goaltrack.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/goaltrack_cat_sleep" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipExercise"
                    style="@style/Widget.Goaltrack.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/goaltrack_cat_exercise" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCustom"
                    style="@style/Widget.Goaltrack.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/goaltrack_cat_custom" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Goal name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="20dp"
                android:text="@string/goaltrack_name_label"
                android:textColor="@color/settings_title"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editGoalName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_goaltrack_input"
                android:hint="@string/goaltrack_name_hint"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLength="60"
                android:maxLines="1"
                android:minHeight="52dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/settings_text"
                android:textColorHint="@color/settings_text_secondary"
                android:textSize="15sp" />

            <!-- Target value + unit -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="20dp"
                android:text="@string/goaltrack_target_label"
                android:textColor="@color/settings_title"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_goaltrack_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="10dp">

                <EditText
                    android:id="@+id/editTargetValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/goaltrack_target_hint"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:maxLength="9"
                    android:maxLines="1"
                    android:minHeight="52dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp"
                    android:textColor="@color/settings_text"
                    android:textColorHint="@color/settings_text_secondary"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/editUnit"
                    android:layout_width="104dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_goaltrack_unit_pill"
                    android:gravity="center"
                    android:hint="@string/goaltrack_unit_hint"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLength="20"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textColor="@color/settings_text"
                    android:textColorHint="@color/settings_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Frequency -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="20dp"
                android:text="@string/goaltrack_frequency_label"
                android:textColor="@color/settings_title"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupFrequency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDaily"
                    style="@style/Widget.Goaltrack.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/goaltrack_freq_daily" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipWeekly"
                    style="@style/Widget.Goaltrack.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/goaltrack_freq_weekly" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMonthly"
                    style="@style/Widget.Goaltrack.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/goaltrack_freq_monthly" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Reminders -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/settings_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp">

                    <!-- Tap to change the reminder time -->
                    <LinearLayout
                        android:id="@+id/rowReminderTime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/goaltrack_reminders"
                            android:textColor="@color/settings_text"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textReminderTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/settings_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchReminders"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:contentDescription="@string/goaltrack_reminders"
                        android:thumb="@drawable/switch_thumb"
                        android:track="@drawable/switch_track"
                        app:useMaterialThemeColors="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/textError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/error_red"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progressSaving"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <!-- Actions -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSave"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:text="@string/goaltrack_create"
                android:textAllCaps="false"
                android:textColor="@color/goaltrack_btn_text"
                app:backgroundTint="@color/goaltrack_btn_primary"
                app:cornerRadius="26dp" />

            <!-- Edit mode only -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDelete"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="@string/goaltrack_delete"
                android:textAllCaps="false"
                android:textColor="@color/error_red"
                android:visibility="gone"
                app:cornerRadius="26dp"
                app:strokeColor="@color/error_red" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true" />

</RelativeLayout>
