<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8EFE3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <ImageButton
            android:id="@+id/buttonBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Diary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#1B3A1B" />

        <!-- ===== Meals section ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Meals"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1B3A1B" />

        <include
            android:id="@+id/sectionBreakfast"
            layout="@layout/item_meal_section" />

        <include
            android:id="@+id/sectionLunch"
            layout="@layout/item_meal_section" />

        <include
            android:id="@+id/sectionDinner"
            layout="@layout/item_meal_section" />

        <include
            android:id="@+id/sectionSnack"
            layout="@layout/item_meal_section" />

        <!-- ===== Water section ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Water"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1B3A1B" />

        <TextView
            android:id="@+id/textWaterSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="15sp"
            android:textColor="#4A4A4A" />

        <GridLayout
            android:id="@+id/gridCups"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:columnCount="4"
            android:rowCount="2" />

        <!-- ===== Mood section ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Mood"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1B3A1B" />

        <LinearLayout
            android:id="@+id/containerMoodEntries"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/textNoMoodToday"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="No mood logged yet today"
            android:textColor="#8A8A8A"
            android:visibility="gone" />

        <!-- ===== Notes section ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Notes"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1B3A1B" />

        <EditText
            android:id="@+id/editNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minLines="4"
            android:gravity="top"
            android:hint="Write anything about your day..."
            android:background="@android:color/white"
            android:padding="12dp"
            android:inputType="textMultiLine" />

    </LinearLayout>
</ScrollView>