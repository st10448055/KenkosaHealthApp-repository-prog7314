<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_bg"
    android:clipChildren="false">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollLogMood"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNav"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="56dp">

            <!-- Header: menu + notification bell -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageButton
                    android:id="@+id/buttonMenu"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_centerVertical="true"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/menu"
                    android:src="@drawable/ic_menu"
                    app:tint="@color/settings_title" />

                <FrameLayout
                    android:id="@+id/buttonNotifications"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/bg_circle_deep_green"
                    android:contentDescription="@string/notifications">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_bell"
                        app:tint="@color/white" />
                </FrameLayout>
            </RelativeLayout>

            <TextView
                android:id="@+id/textTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="8dp"
                android:text="@string/log_mood_title"
                android:textColor="@color/settings_title"
                android:textSize="30sp"
                android:textStyle="bold" />

            <!-- Date and time (tap to change) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_date_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="36dp"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/feeling_text"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/chipTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_date_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="36dp"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/feeling_text"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Select mood -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="24dp"
                android:text="@string/mood_select_label"
                android:textColor="@color/settings_title"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/settings_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="10dp">

                <ImageButton
                    android:id="@+id/moodVeryHappy"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:contentDescription="@string/mood_very_happy"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_mood_very_happy" />

                <ImageButton
                    android:id="@+id/moodHappy"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:contentDescription="@string/mood_happy"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_mood_happy" />

                <ImageButton
                    android:id="@+id/moodNeutral"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:contentDescription="@string/mood_neutral"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_mood_neutral" />

                <ImageButton
                    android:id="@+id/moodSad"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:contentDescription="@string/mood_sad"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_mood_sad" />

                <ImageButton
                    android:id="@+id/moodVerySad"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:contentDescription="@string/mood_very_sad"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_mood_very_sad" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Feeling -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="24dp"
                android:text="@string/mood_feeling_label"
                android:textColor="@color/settings_title"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupFeelings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="4dp"
                app:singleSelection="false" />

            <TextView
                android:id="@+id/textError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/error_red"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progressSaving"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <!-- Actions -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonEditMood"
                android:layout_width="220dp"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="28dp"
                android:text="@string/edit_mood"
                android:textAllCaps="false"
                android:textColor="@color/deep_green"
                app:backgroundTint="@color/med_btn_edit"
                app:cornerRadius="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSaveMood"
                android:layout_width="220dp"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:text="@string/save"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:backgroundTint="@color/med_btn_save"
                app:cornerRadius="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonCancelMood"
                android:layout_width="220dp"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:text="@string/cancel"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:backgroundTint="@color/med_btn_cancel"
                app:cornerRadius="24dp" />

            <!-- Edit mode only -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDeleteMood"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="220dp"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:text="@string/delete"
                android:textAllCaps="false"
                android:textColor="@color/error_red"
                android:visibility="gone"
                app:cornerRadius="24dp"
                app:strokeColor="@color/error_red" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true" />

</RelativeLayout>
