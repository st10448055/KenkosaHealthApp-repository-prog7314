<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_bg"
    android:clipChildren="false">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollAddSleep"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNav"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="120dp">

            <!-- Header: menu + notification bell -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageButton
                    android:id="@+id/buttonMenu"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_centerVertical="true"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/menu"
                    android:src="@drawable/ic_menu"
                    app:tint="@color/settings_title" />

                <FrameLayout
                    android:id="@+id/buttonNotifications"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/bg_circle_deep_green"
                    android:contentDescription="@string/notifications">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_bell"
                        app:tint="@color/white" />
                </FrameLayout>
            </RelativeLayout>

            <TextView
                android:id="@+id/textTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="8dp"
                android:text="@string/sleeplog_add_title"
                android:textColor="@color/settings_title"
                android:textSize="30sp"
                android:textStyle="bold" />

            <!-- Wake-up date -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="20dp"
                android:text="@string/sleeplog_wake_date"
                android:textColor="@color/settings_title"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipWakeDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_sleeplog_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="36dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/sleeplog_pill_text"
                android:textSize="13sp" />

            <!-- Bedtime and wake-up time -->
            <LinearLayout
                android:id="@+id/rowBedtime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_sleeplog_icon_circle">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_sleeplog_moon"
                        app:tint="@color/settings_title" />
                </FrameLayout>

                <TextView
                    android:id="@+id/textBedtime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_sleeplog_field"
                    android:contentDescription="@string/sleeplog_bedtime"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/settings_text"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowWakeTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_sleeplog_icon_circle">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_sleeplog_sun"
                        app:tint="@color/settings_title" />
                </FrameLayout>

                <TextView
                    android:id="@+id/textWakeTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_sleeplog_field"
                    android:contentDescription="@string/sleeplog_wake_time"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/settings_text"
                    android:textSize="15sp" />
            </LinearLayout>


            <!-- Total sleep -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_horizontal"
                android:text="@string/sleeplog_total_caps"
                android:textColor="@color/settings_text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/textTotalSleep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_horizontal"
                android:textColor="@color/settings_title"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- Sleep quality -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="24dp"
                android:text="@string/sleeplog_quality"
                android:textColor="@color/settings_title"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/sleeplog_q_poor"
                    android:textColor="@color/settings_text_secondary"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/faceQ1"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@null"
                    android:contentDescription="@string/sleeplog_q_poor"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_sleepq_1" />
                <ImageButton
                    android:id="@+id/faceQ2"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@null"
                    android:contentDescription="@string/sleeplog_q_fair"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_sleepq_2" />
                <ImageButton
                    android:id="@+id/faceQ3"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@null"
                    android:contentDescription="@string/sleeplog_q_okay"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_sleepq_3" />
                <ImageButton
                    android:id="@+id/faceQ4"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@null"
                    android:contentDescription="@string/sleeplog_q_good"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_sleepq_4" />
                <ImageButton
                    android:id="@+id/faceQ5"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@null"
                    android:contentDescription="@string/sleeplog_q_excellent"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_sleepq_5" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="@string/sleeplog_q_excellent"
                    android:textColor="@color/settings_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Notes -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="24dp"
                android:text="@string/sleeplog_notes"
                android:textColor="@color/settings_title"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_sleeplog_field"
                android:gravity="top|start"
                android:hint="@string/sleeplog_notes_hint"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="500"
                android:minHeight="120dp"
                android:padding="16dp"
                android:textColor="@color/settings_text"
                android:textColorHint="@color/settings_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/error_red"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progressSaving"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <!-- Actions -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSave"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:text="@string/sleeplog_save"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:backgroundTint="@color/sleeplog_btn_save"
                app:cornerRadius="26dp" />

            <!-- Edit mode only -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDelete"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="@string/sleeplog_delete"
                android:textAllCaps="false"
                android:textColor="@color/error_red"
                android:visibility="gone"
                app:cornerRadius="26dp"
                app:strokeColor="@color/error_red" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true" />

</RelativeLayout>
