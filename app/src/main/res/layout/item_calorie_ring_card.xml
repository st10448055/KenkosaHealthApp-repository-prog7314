<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="28dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="24dp">

        <!-- Left: ring + remaining -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <FrameLayout
                android:layout_width="140dp"
                android:layout_height="140dp">

                <com.example.kenkosahealthapp_prog7314.ui.home.CalorieRingView
                    android:id="@+id/ringCalories"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Remaining"
                android:textColor="#6A6A6A"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/textCaloriesRemaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#1B3A1B"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="360 kcal" />

        </LinearLayout>

        <!-- Right: macros -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Macros"
                android:textColor="#1B3A1B"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textMacroCarbs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_macro_pill"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:textColor="#4A2E6B"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Carbs: 7g" />

            <TextView
                android:id="@+id/textMacroProtein"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_macro_pill"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:textColor="#1E4A73"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Protein: 13g" />

            <TextView
                android:id="@+id/textMacroFat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_macro_pill"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:textColor="#3D4A2E"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Fats: 10g" />

            <TextView
                android:id="@+id/textCalorieStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_macro_pill"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:textColor="#6B5A1E"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="On Track" />

        </LinearLayout>

    </LinearLayout>

    <ProgressBar
        android:id="@+id/progressCalorieRing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <TextView
        android:id="@+id/textCalorieError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:gravity="center"
        android:textColor="#6A6A6A"
        android:textSize="13sp"
        android:visibility="gone" />

</androidx.cardview.widget.CardView>