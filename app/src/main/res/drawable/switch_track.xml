<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <size android:width="44dp" android:height="24dp" />
            <solid android:color="@color/settings_switch_on" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <size android:width="44dp" android:height="24dp" />
            <solid android:color="@color/settings_switch_off" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
